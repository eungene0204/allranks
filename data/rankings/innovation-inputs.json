  "category": "tech",
  "icon": "🔬",
  "desc": "WIPO Global Innovation Index 2026 — Innovation inputs. The Innovation Input Sub-Index is comprised of five input pillars that capture elements of the economy that enable and facilitate innovative activities: (1) Institutions, (2) Human capital and research, (3) Infrastructure, (4) Market sophistication, and (5) Business sophistication. Higher scores rank first.",
  "unit": "GII score (0–100)",
  "prefix": "",
  "suffix": "",
  "decimals": 2,
  "order": "desc",
  "year": 2026,
